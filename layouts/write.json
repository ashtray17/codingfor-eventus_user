{
  "version": "1.0.0",
  "layout_name": "write",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "{{route.id ? '$t:community.write.edit_page_title' : '$t:community.write.page_title'}}",
    "description": "$t:community.write.page_description"
  },
  "initLocal": {
    "write_title": "",
    "write_content": "",
    "write_category": "",
    "write_submitting": false,
    "write_error": ""
  },
  "data_sources": [
    {
      "id": "form_data",
      "label_key": "$t:community.data_source.form_data",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts/form-data",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "required",
      "cache": false,
      "refetchOnMount": true,
      "loading_strategy": "blocking",
      "params": {
        "post_id": "{{route?.id ?? ''}}"
      },
      "onSuccess": {
        "handler": "setState",
        "params": {
          "target": "local",
          "write_title": "{{response.data.data.title ?? ''}}",
          "write_content": "{{response.data.data.content ?? ''}}",
          "write_category": "{{response.data.data.category ?? ''}}"
        }
      },
      "errorHandling": {
        "403": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        },
        "404": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        }
      }
    },
    {
      "id": "form_meta",
      "label_key": "$t:community.data_source.form_meta",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts/form-meta",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "required",
      "cache": false,
      "refetchOnMount": true,
      "params": {
        "post_id": "{{route?.id ?? ''}}"
      },
      "errorHandling": {
        "403": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        },
        "404": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "write_root",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "overflow-hidden rounded-card border border-rule bg-paper-2 px-6 py-6"
        },
        "children": [
          {
            "id": "write_intro",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "border-b border-rule pb-3"
            },
            "children": [
              {
                "id": "write_heading",
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "text-[22px] font-bold tracking-[-0.03em] text-ink"
                },
                "text": "{{route.id ? '$t:community.write.title_edit' : '$t:community.write.title_new'}}"
              },
              {
                "id": "write_board_name",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mt-1 block text-[13px] leading-6 text-muted"
                },
                "text": "{{form_meta?.data?.board?.name ?? ''}}"
              }
            ]
          },
          {
            "id": "write_form",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "pt-5"
            },
            "children": [
              {
                "id": "write_category_field",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mb-3"
                },
                "if": "{{(form_meta?.data?.board?.categories ?? []).length > 0}}",
                "children": [
                  {
                    "id": "write_category_label",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                    },
                    "text": "$t:community.write.category_label"
                  },
                  {
                    "id": "write_category_options",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex flex-wrap gap-1.5"
                    },
                    "children": [
                      {
                        "id": "write_category_none",
                        "type": "basic",
                        "name": "Button",
                        "props": {
                          "type": "button",
                          "className": "cursor-pointer rounded-ctl border px-3 py-1.5 text-[12px] font-medium transition-colors duration-150 {{(_local.write_category ?? '') === '' ? 'border-accent bg-accent-wash text-accent' : 'border-rule text-muted hover:border-rule-2 hover:text-ink'}}"
                        },
                        "actions": [
                          {
                            "type": "click",
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "write_category": "",
                              "write_error": ""
                            }
                          }
                        ],
                        "text": "$t:community.write.category_none"
                      },
                      {
                        "id": "write_category_item_{{category_item}}",
                        "type": "basic",
                        "name": "Button",
                        "iteration": {
                          "source": "{{form_meta?.data?.board?.categories ?? []}}",
                          "item_var": "category_item"
                        },
                        "props": {
                          "type": "button",
                          "aria-pressed": "{{(_local.write_category ?? '') === category_item}}",
                          "className": "cursor-pointer rounded-ctl border px-3 py-1.5 text-[12px] font-medium transition-colors duration-150 {{(_local.write_category ?? '') === category_item ? 'border-accent bg-accent-wash text-accent' : 'border-rule text-muted hover:border-rule-2 hover:text-ink'}}"
                        },
                        "actions": [
                          {
                            "type": "click",
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "write_category": "{{category_item}}",
                              "write_error": ""
                            }
                          }
                        ],
                        "text": "{{category_item}}"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "write_title_field",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mb-3"
                },
                "children": [
                  {
                    "id": "write_title_label",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                    },
                    "text": "$t:community.write.title_label"
                  },
                  {
                    "id": "write_title",
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "type": "text",
                      "name": "title",
                      "placeholder": "$t:community.write.title_placeholder",
                      "aria-label": "$t:community.write.title_label",
                      "value": "{{_local.write_title ?? \"\"}}",
                      "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                    },
                    "actions": [
                      {
                        "type": "input",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "write_title": "{{$event.target.value}}",
                          "write_error": ""
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "write_content_field",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mb-3"
                },
                "children": [
                  {
                    "id": "write_content_label",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                    },
                    "text": "$t:community.write.content_label"
                  },
                  {
                    "id": "write_content",
                    "type": "basic",
                    "name": "Textarea",
                    "props": {
                      "name": "content",
                      "rows": 12,
                      "placeholder": "$t:community.write.content_placeholder",
                      "aria-label": "$t:community.write.content_label",
                      "value": "{{_local.write_content ?? \"\"}}",
                      "className": "min-h-[240px] w-full resize-y rounded-ctl border border-rule bg-paper px-3 py-2.5 text-[14px] leading-6 text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                    },
                    "actions": [
                      {
                        "type": "input",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "write_content": "{{$event.target.value}}",
                          "write_error": ""
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "write_image_uploader",
                "type": "composite",
                "name": "ImageUploader",
                "props": {
                  "compact": true,
                  "targetTextareaSelector": "textarea[name='content']",
                  "title": "$t:community.write.uploader_title",
                  "description": "$t:community.write.uploader_description",
                  "chooseLabel": "$t:community.images.choose",
                  "insertLabel": "$t:community.images.insert",
                  "insertAllLabel": "$t:community.images.insert_all",
                  "insertedLabel": "$t:community.images.inserted",
                  "copyLabel": "$t:community.images.copy",
                  "copyAllLabel": "$t:community.images.copy_all",
                  "copiedLabel": "$t:community.images.copied",
                  "copyAllCopiedLabel": "$t:community.images.copy_all_copied",
                  "processingLabel": "$t:community.images.processing",
                  "readyLabel": "$t:community.images.ready",
                  "deleteLabel": "$t:community.images.delete",
                  "emptyLabel": "$t:community.images.empty",
                  "maxSizeMb": 50,
                  "memberMaxSizeMb": 250,
                  "chunkSizeMb": 16,
                  "uploadEndpoint": "/api/modules/codingfor-imagehost/images",
                  "listEndpoint": "/api/modules/codingfor-imagehost/images",
                  "statusBase": "/api/modules/codingfor-imagehost/images/",
                  "className": "mb-4 bg-paper"
                }
              },
              {
                "id": "write_error",
                "type": "basic",
                "name": "Div",
                "props": {
                  "role": "alert",
                  "aria-live": "polite",
                  "className": "mt-2 rounded-ctl border border-danger-border bg-danger-wash px-3 py-2 text-[12px] text-danger"
                },
                "if": "{{_local.write_error}}",
                "text": "{{_local.write_error ?? \"\"}}"
              },
              {
                "id": "write_actions",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mt-5 flex items-center justify-end gap-2"
                },
                "children": [
                  {
                    "id": "write_cancel",
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "className": "cursor-pointer rounded-ctl border border-rule px-3.5 py-2 text-[13px] font-medium text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "navigate",
                        "params": {
                          "path": "{{route.id ? '/board/' + route.slug + '/' + route.id : '/board/' + route.slug}}"
                        }
                      }
                    ],
                    "text": "$t:community.write.cancel"
                  },
                  {
                    "id": "write_submit",
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "className": "cursor-pointer rounded-ctl bg-accent px-4 py-2 text-[13px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40",
                      "disabled": "{{_local.write_submitting === true}}"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "sequence",
                        "if": "{{_local.write_submitting !== true && (_local.write_title ?? '').trim() !== '' && (_local.write_content ?? '').trim() !== ''}}",
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "write_submitting": true,
                              "write_error": ""
                            }
                          },
                          {
                            "handler": "apiCall",
                            "target": "{{route.id ? '/api/modules/sirsoft-board/boards/' + route.slug + '/posts/' + route.id : '/api/modules/sirsoft-board/boards/' + route.slug + '/posts'}}",
                            "auth_mode": "required",
                            "params": {
                              "method": "{{route.id ? 'PUT' : 'POST'}}",
                              "body": {
                                "title": "{{_local.write_title ?? ''}}",
                                "content": "{{_local.write_content ?? ''}}",
                                "content_mode": "{{(_local.write_content ?? '').includes('<') ? 'html' : 'text'}}",
                                "category": "{{_local.write_category ?? ''}}"
                              }
                            },
                            "onSuccess": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "write_submitting": false,
                                  "write_error": ""
                                }
                              },
                              {
                                "handler": "navigate",
                                "params": {
                                  "path": "/board/{{route.slug}}/{{result?.data?.id ?? route.id}}"
                                }
                              }
                            ],
                            "onError": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "write_submitting": false,
                                  "write_error": "{{error.message}}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ],
                    "text": "{{route.id ? '$t:community.write.submit_edit' : '$t:community.write.submit'}}"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
