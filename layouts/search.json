{
  "version": "1.0.0",
  "layout_name": "search",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.search.page_title",
    "description": "$t:community.search.page_description",
    "seo": {
      "enabled": true,
      "data_sources": ["search_results"],
      "page_type": "search",
      "vars": {
        "site_name": "$core_settings:general.site_name"
      },
      "priority": 0.3,
      "changefreq": "daily",
      "og": {
        "type": "website"
      },
      "structured_data": {
        "@type": "SearchResultsPage"
      }
    }
  },
  "initLocal": {
    "search_q": ""
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "search_q": "{{query.q ?? ''}}"
      }
    }
  ],
  "data_sources": [
    {
      "id": "search_results",
      "label_key": "$t:community.data_source.search_results",
      "type": "api",
      "endpoint": "/api/search",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "refetchOnMount": true,
      "condition": "{{(query.q ?? '').trim().length >= 2}}",
      "params": {
        "q": "{{query.q ?? ''}}",
        "type": "posts",
        "page": "{{query.page ?? 1}}",
        "per_page": 10
      },
      "fallback": {
        "data": {
          "q": "",
          "total": 0,
          "posts": {
            "total": 0,
            "items": []
          },
          "current_page": 1,
          "last_page": 1,
          "posts_count": 0
        }
      },
      "errorHandling": {
        "401": {
          "handler": "suppress"
        },
        "403": {
          "handler": "suppress"
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "search_root",
        "type": "basic",
        "name": "Div",
        "children": [
          {
            "id": "search_intro",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-6"
            },
            "children": [
              {
                "id": "search_title",
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "text-[24px] font-bold tracking-[-0.03em] text-ink sm:text-[28px]"
                },
                "text": "$t:community.search.title"
              },
              {
                "id": "search_lede",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mt-1.5 block text-[13px] leading-6 text-muted"
                },
                "text": "$t:community.search.lede"
              }
            ]
          },
          {
            "id": "search_bar",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-5 flex items-center gap-2"
            },
            "children": [
              {
                "id": "search_input",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "search",
                  "name": "q",
                  "placeholder": "$t:community.search.placeholder",
                  "aria-label": "$t:community.search.placeholder",
                  "value": "{{_local.search_q ?? query.q ?? \"\"}}",
                  "className": "h-11 min-w-0 flex-1 rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "search_q": "{{$event.target.value}}"
                    }
                  },
                  {
                    "type": "keydown",
                    "key": "Enter",
                    "handler": "navigate",
                    "params": {
                      "path": "/search",
                      "query": {
                        "q": "{{$event.target.value}}",
                        "page": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "search_submit",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "h-11 shrink-0 cursor-pointer rounded-ctl bg-accent px-4 text-[13px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/search",
                      "query": {
                        "q": "{{_local.search_q ?? ''}}",
                        "page": 1
                      }
                    }
                  }
                ],
                "text": "$t:community.search.submit"
              }
            ]
          },
          {
            "id": "search_hint",
            "type": "basic",
            "name": "Div",
            "if": "{{!(query.q ?? '').trim()}}",
            "props": {
              "className": "rounded-card border border-rule bg-paper-2 py-10 text-center text-[13px] text-faint"
            },
            "text": "$t:community.search.hint"
          },
          {
            "id": "search_too_short",
            "type": "basic",
            "name": "Div",
            "if": "{{(query.q ?? '').trim().length > 0 && (query.q ?? '').trim().length < 2}}",
            "props": {
              "className": "rounded-card border border-rule bg-paper-2 py-10 text-center text-[13px] text-faint"
            },
            "text": "$t:community.search.too_short"
          },
          {
            "id": "search_empty",
            "type": "basic",
            "name": "Div",
            "if": "{{(query.q ?? '').trim().length >= 2 && (search_results?.data?.posts?.items ?? []).length === 0}}",
            "props": {
              "className": "rounded-card border border-rule bg-paper-2 py-10 text-center text-[13px] text-faint"
            },
            "text": "$t:community.search.empty"
          },
          {
            "id": "search_stat",
            "type": "basic",
            "name": "Div",
            "if": "{{(search_results?.data?.posts?.items ?? []).length > 0}}",
            "props": {
              "className": "mb-3 flex items-center gap-2"
            },
            "children": [
              {
                "id": "search_stat_count",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "tnum font-mono text-[11px] text-muted"
                },
                "text": "{{search_results?.data?.posts_count ?? search_results?.data?.total ?? 0}}"
              },
              {
                "id": "search_stat_unit",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "text-[11px] tracking-[0.1em] text-faint"
                },
                "text": "$t:community.search.total_unit"
              }
            ]
          },
          {
            "id": "search_list",
            "type": "basic",
            "name": "Div",
            "if": "{{(search_results?.data?.posts?.items ?? []).length > 0}}",
            "props": {
              "className": "overflow-hidden rounded-card border border-rule bg-paper-2"
            },
            "children": [
              {
                "id": "search_item_{{post.id}}",
                "type": "basic",
                "name": "A",
                "iteration": {
                  "source": "{{search_results?.data?.posts?.items ?? []}}",
                  "item_var": "post"
                },
                "props": {
                  "href": "{{post.url ?? ('/board/' + (post.board_slug ?? '') + '/' + post.id)}}",
                  "className": "group block border-b border-rule px-4 py-3 last:border-0 transition-colors duration-150 hover:bg-paper-3"
                },
                "children": [
                  {
                    "id": "search_item_top_{{post.id}}",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex items-baseline gap-2"
                    },
                    "children": [
                      {
                        "id": "search_item_board_{{post.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "shrink-0 text-[11px] text-faint"
                        },
                        "text": "{{post.board_name ?? ''}}"
                      },
                      {
                        "id": "search_item_title_{{post.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "min-w-0 truncate text-[14px] text-ink-2 group-hover:text-accent"
                        },
                        "text": "{{post.title ?? ''}}"
                      }
                    ]
                  },
                  {
                    "id": "search_item_preview_{{post.id}}",
                    "type": "basic",
                    "name": "Span",
                    "if": "{{post.content_preview}}",
                    "props": {
                      "className": "mt-1 block line-clamp-2 text-[12px] leading-5 text-muted"
                    },
                    "text": "{{post.content_preview ?? ''}}"
                  },
                  {
                    "id": "search_item_meta_{{post.id}}",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "mt-1.5 flex items-center gap-2 text-[11px] text-faint"
                    },
                    "children": [
                      {
                        "id": "search_item_author_{{post.id}}",
                        "type": "basic",
                        "name": "Span",
                        "text": "{{post.author_name ?? ''}}"
                      },
                      {
                        "id": "search_item_date_{{post.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "tnum"
                        },
                        "text": "{{post.created_at_formatted ?? ''}}"
                      },
                      {
                        "id": "search_item_views_{{post.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "tnum"
                        },
                        "text": "{{post.view_count ?? 0}}"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "search_pagination",
            "type": "basic",
            "name": "Div",
            "if": "{{(search_results?.data?.last_page ?? 1) > 1}}",
            "props": {
              "className": "mt-3 flex items-center justify-between gap-3 rounded-card border border-rule bg-paper-2 px-4 py-3"
            },
            "children": [
              {
                "id": "search_prev",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "cursor-pointer rounded-ctl border border-rule px-3 py-2 text-[13px] font-medium text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{(search_results?.data?.current_page ?? 1) <= 1}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/search",
                      "mergeQuery": true,
                      "query": {
                        "page": "{{(search_results?.data?.current_page ?? 1) - 1}}"
                      }
                    }
                  }
                ],
                "text": "$t:community.board.prev"
              },
              {
                "id": "search_page_state",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "tnum flex items-baseline gap-1 font-mono text-[12px] text-muted"
                },
                "children": [
                  {
                    "id": "search_page_cur",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "font-semibold text-ink"
                    },
                    "text": "{{search_results?.data?.current_page ?? 1}}"
                  },
                  {
                    "id": "search_page_sep",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "text-faint"
                    },
                    "text": "/"
                  },
                  {
                    "id": "search_page_last",
                    "type": "basic",
                    "name": "Span",
                    "text": "{{search_results?.data?.last_page ?? 1}}"
                  }
                ]
              },
              {
                "id": "search_next",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "cursor-pointer rounded-ctl border border-rule px-3 py-2 text-[13px] font-medium text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{(search_results?.data?.current_page ?? 1) >= (search_results?.data?.last_page ?? 1)}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/search",
                      "mergeQuery": true,
                      "query": {
                        "page": "{{(search_results?.data?.current_page ?? 1) + 1}}"
                      }
                    }
                  }
                ],
                "text": "$t:community.board.next"
              }
            ]
          }
        ]
      }
    ]
  }
}
