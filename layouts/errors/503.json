{
  "version": "1.0.0",
  "layout_name": "503",
  "extends": "_user_base",
  "meta": {
    "title": "$t:error.503.title",
    "description": "$t:error.503.description"
  },
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "flex-center min-h-[50vh] justify-center"
        },
        "children": [
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "text-center px-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "font-mono text-6xl font-bold text-faint mb-4"
                },
                "text": "503"
              },
              {
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "text-2xl font-bold text-ink mb-2"
                },
                "text": "$t:error.503.title"
              },
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "block text-muted mb-6"
                },
                "text": "$t:error.503.description"
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "cursor-pointer rounded-ctl bg-accent px-5 py-2.5 text-[13px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/"
                    }
                  }
                ],
                "text": "$t:error.back_to_home"
              }
            ]
          }
        ]
      }
    ]
  }
}
