{
  "version": "1.0.0",
  "layout_name": "board",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.board.page_title",
    "description": "$t:community.board.page_description",
    "seo": {
      "enabled": true,
      "extensions": [
        { "type": "module", "id": "sirsoft-board" }
      ],
      "data_sources": ["posts"],
      "page_type": "board",
      "toggle_setting": "$module_settings:sirsoft-board:seo.seo_board",
      "vars": {
        "site_name": "$core_settings:general.site_name",
        "board_name": "{{posts.data.board.name ?? ''}}",
        "board_description": "{{posts.data.board.description ?? ''}}"
      },
      "priority": 0.6,
      "changefreq": "daily",
      "og": {
        "type": "website",
        "description": "{{_seo.board.description ?? posts.data.board.description ?? ''}}"
      },
      "structured_data": {
        "@type": "ItemList"
      }
    }
  },
  "data_sources": [
    {
      "id": "posts",
      "label_key": "$t:community.data_source.posts",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "refetchOnMount": true,
      "params": {
        "page": "{{query.page ?? 1}}",
        "category": "{{query.category ?? ''}}"
      },
      "fallback": {
        "data": {
          "data": [],
          "pagination": {
            "current_page": 1,
            "last_page": 1,
            "total": 0
          },
          "board": {
            "name": "",
            "description": "",
            "categories": []
          },
          "abilities": {
            "can_read": false,
            "can_write": false
          }
        }
      },
      "errorHandling": {
        "401": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        },
        "403": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        },
        "404": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "board_root",
        "type": "basic",
        "name": "Div",
        "children": [
          {
            "id": "board_intro",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-6 flex items-start justify-between gap-4"
            },
            "children": [
              {
                "id": "board_intro_text",
                "type": "basic",
                "name": "Div",
                "children": [
                  {
                    "id": "board_name",
                    "type": "basic",
                    "name": "H1",
                    "props": {
                      "className": "text-[24px] font-bold tracking-[-0.03em] text-ink sm:text-[28px]"
                    },
                    "text": "{{posts?.data?.board?.name ?? \"\"}}"
                  },
                  {
                    "id": "board_desc",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "mt-1.5 block max-w-[60ch] text-[13px] leading-6 text-muted"
                    },
                    "if": "{{posts?.data?.board?.description}}",
                    "text": "{{posts?.data?.board?.description ?? \"\"}}"
                  },
                  {
                    "id": "board_stat",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "mt-3 inline-flex items-center gap-1.5 rounded-ctl bg-accent-wash px-2.5 py-1"
                    },
                    "children": [
                      {
                        "id": "board_stat_count",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "tnum font-mono text-[11px] font-semibold text-accent"
                        },
                        "text": "{{posts?.data?.pagination?.total ?? 0}}"
                      },
                      {
                        "id": "board_stat_unit",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-[11px] font-medium text-accent"
                        },
                        "text": "$t:community.board.total_unit"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "board_write",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "shrink-0 cursor-pointer rounded-ctl bg-accent px-3.5 py-2 text-[13px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "switch",
                    "params": {
                        "value": "{{_global.currentUser?.uuid && posts?.data?.abilities?.can_write ? 'allowed' : (_global.currentUser?.uuid ? 'no_permission' : 'not_logged_in')}}"
                    },
                    "cases": {
                      "allowed": {
                        "handler": "navigate",
                        "params": {
                          "path": "/board/{{route.slug}}/write"
                        }
                      },
                      "no_permission": {
                        "handler": "toast",
                        "params": {
                          "type": "warning",
                          "message": "$t:community.write.no_permission"
                        }
                      },
                      "not_logged_in": {
                        "handler": "sequence",
                        "actions": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "info",
                              "message": "$t:community.write.login_required"
                            }
                          },
                          {
                            "handler": "navigate",
                            "params": {
                              "path": "/login",
                              "query": {
                                "redirect": "/board/{{route.slug}}/write"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ],
                "text": "$t:community.board.write"
              }
            ]
          },
          {
            "id": "board_categories",
            "type": "basic",
            "name": "Div",
            "if": "{{(posts?.data?.board?.categories ?? []).length > 0}}",
            "props": {
              "className": "mb-4 flex flex-wrap items-center gap-1.5"
            },
            "children": [
              {
                "id": "board_category_all",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "aria-pressed": "{{!(query.category ?? '')}}",
                  "className": "cursor-pointer rounded-full border px-3.5 py-1.5 text-[12px] font-semibold transition-colors duration-150 {{!(query.category ?? '') ? 'border-accent bg-accent text-accent-ink' : 'border-rule bg-paper-2 text-muted hover:border-rule-2 hover:text-ink'}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/board/{{route.slug}}",
                      "query": {
                        "page": 1
                      }
                    }
                  }
                ],
                "text": "$t:community.board.category_all"
              },
              {
                "id": "board_category_item_{{category_item}}",
                "type": "basic",
                "name": "Button",
                "iteration": {
                  "source": "{{posts?.data?.board?.categories ?? []}}",
                  "item_var": "category_item"
                },
                "props": {
                  "type": "button",
                  "aria-pressed": "{{(query.category ?? '') === category_item}}",
                  "className": "cursor-pointer rounded-full border px-3.5 py-1.5 text-[12px] font-semibold transition-colors duration-150 {{(query.category ?? '') === category_item ? 'border-accent bg-accent text-accent-ink' : 'border-rule bg-paper-2 text-muted hover:border-rule-2 hover:text-ink'}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/board/{{route.slug}}",
                      "query": {
                        "category": "{{category_item}}",
                        "page": 1
                      }
                    }
                  }
                ],
                "text": "{{category_item}}"
              }
            ]
          },
          {
            "id": "board_empty",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "rounded-card border border-rule bg-paper-2 py-10 text-center text-[13px] text-faint"
            },
            "if": "{{(posts?.data?.data ?? []).length === 0}}",
            "text": "$t:community.board.empty"
          },
          {
            "id": "board_list",
            "type": "basic",
            "name": "Div",
            "if": "{{(posts?.data?.data ?? []).length > 0}}",
            "props": {
              "className": "overflow-hidden rounded-card border border-rule bg-paper-2 px-2 pb-1"
            },
            "children": [
              {
                "id": "board_ruler",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex items-center gap-3 border-b border-rule px-1 pb-1.5"
                },
                "children": [
                  {
                    "id": "board_ruler_c1",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "hidden w-16 shrink-0 text-[10px] tracking-[0.1em] text-faint sm:block"
                    },
                    "text": "$t:community.board.col_category"
                  },
                  {
                    "id": "board_ruler_c2",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "min-w-0 flex-1 text-[10px] tracking-[0.1em] text-faint"
                    },
                    "text": "$t:community.board.col_title"
                  },
                  {
                    "id": "board_ruler_c3",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "hidden w-24 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint md:block"
                    },
                    "text": "$t:community.board.col_author"
                  },
                  {
                    "id": "board_ruler_c4",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "hidden w-20 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint sm:block"
                    },
                    "text": "$t:community.board.col_date"
                  },
                  {
                    "id": "board_ruler_c5",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "hidden w-12 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint lg:block"
                    },
                    "text": "$t:community.board.col_views"
                  }
                ]
              },
              {
                "id": "board_post_{{post_item.id}}",
                "type": "basic",
                "name": "A",
                "iteration": {
                  "source": "{{posts?.data?.data ?? []}}",
                  "item_var": "post_item"
                },
                "props": {
                  "href": "/board/{{route.slug}}/{{post_item.id}}",
                  "className": "group flex items-center gap-3 border-b border-rule px-2 py-2.5 last:border-0 transition-colors duration-150 hover:bg-paper-3"
                },
                "children": [
                  {
                    "id": "board_post_cat_{{post_item.id}}",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "hidden w-16 shrink-0 truncate text-[11px] text-faint sm:block"
                    },
                    "text": "{{post_item?.category ?? \"\"}}"
                  },
                  {
                    "id": "board_post_main_{{post_item.id}}",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex min-w-0 flex-1 items-baseline gap-1.5"
                    },
                    "children": [
                      {
                        "id": "board_post_notice_{{post_item.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "shrink-0 rounded-ctl bg-accent-wash px-1.5 py-0.5 text-[10px] font-semibold text-accent"
                        },
                        "if": "{{post_item?.is_notice}}",
                        "text": "$t:community.board.notice"
                      },
                      {
                        "id": "board_post_title_{{post_item.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "min-w-0 truncate text-[14px] text-ink-2 group-hover:text-accent"
                        },
                        "text": "{{post_item?.title ?? \"\"}}"
                      },
                      {
                        "id": "board_post_cc_{{post_item.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "tnum shrink-0 font-mono text-[11px] font-semibold text-accent"
                        },
                        "if": "{{(post_item?.comment_count ?? 0) > 0}}",
                        "text": "{{post_item?.comment_count ?? 0}}"
                      },
                      {
                        "id": "board_post_new_{{post_item.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "shrink-0 font-mono text-[10px] font-semibold text-accent"
                        },
                        "if": "{{post_item?.is_new}}",
                        "text": "N"
                      }
                    ]
                  },
                  {
                    "id": "board_post_author_{{post_item.id}}",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "hidden w-24 shrink-0 truncate text-right text-[12px] text-muted md:block"
                    },
                    "text": "{{post_item?.author?.name ?? \"-\"}}"
                  },
                  {
                    "id": "board_post_date_{{post_item.id}}",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "tnum hidden w-20 shrink-0 text-right text-[11px] text-faint sm:block"
                    },
                    "text": "{{post_item?.created_at_formatted ?? \"\"}}"
                  },
                  {
                    "id": "board_post_views_{{post_item.id}}",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "tnum hidden w-12 shrink-0 text-right font-mono text-[11px] text-faint lg:block"
                    },
                    "text": "{{post_item?.view_count ?? 0}}"
                  }
                ]
              }
            ]
          },
          {
            "id": "board_pagination",
            "type": "basic",
            "name": "Div",
            "if": "{{(posts?.data?.data ?? []).length > 0}}",
            "props": {
              "className": "mt-3 flex items-center justify-between gap-3 rounded-card border border-rule bg-paper-2 px-4 py-3"
            },
            "children": [
              {
                "id": "board_previous_page",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "cursor-pointer rounded-ctl border border-rule px-3 py-2 text-[13px] font-medium text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{(posts?.data?.pagination?.current_page ?? 1) <= 1}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/board/{{route.slug}}",
                      "mergeQuery": true,
                      "query": {
                        "page": "{{(posts?.data?.pagination?.current_page ?? 1) - 1}}"
                      }
                    }
                  }
                ],
                "text": "$t:community.board.prev"
              },
              {
                "id": "board_page_state",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "tnum flex items-baseline gap-1 font-mono text-[12px] text-muted"
                },
                "children": [
                  {
                    "id": "board_page_cur",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "font-semibold text-ink"
                    },
                    "text": "{{posts?.data?.pagination?.current_page ?? 1}}"
                  },
                  {
                    "id": "board_page_sep",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "text-faint"
                    },
                    "text": "/"
                  },
                  {
                    "id": "board_page_last",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": ""
                    },
                    "text": "{{posts?.data?.pagination?.last_page ?? 1}}"
                  }
                ]
              },
              {
                "id": "board_next_page",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "cursor-pointer rounded-ctl border border-rule px-3 py-2 text-[13px] font-medium text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{!(posts?.data?.pagination?.has_more_pages ?? false)}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/board/{{route.slug}}",
                      "mergeQuery": true,
                      "query": {
                        "page": "{{(posts?.data?.pagination?.current_page ?? 1) + 1}}"
                      }
                    }
                  }
                ],
                "text": "$t:community.board.next"
              }
            ]
          }
        ]
      }
    ]
  }
}
