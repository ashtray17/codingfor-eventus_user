{
  "version": "1.0.0",
  "layout_name": "login",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.login.page_title",
    "description": "$t:community.login.page_description",
    "guest_only": true
  },
  "initLocal": {
    "login_email": "",
    "login_password": "",
    "login_submitting": false,
    "login_error": ""
  },
  "slots": {
    "content": [
      {
        "id": "login_root",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "mx-auto w-full max-w-[380px] overflow-hidden rounded-card border border-rule bg-paper-2 px-6 py-7"
        },
        "children": [
          {
            "id": "login_intro",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "border-b border-rule pb-3"
            },
            "children": [
              {
                "id": "login_title",
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "text-[22px] font-bold tracking-[-0.03em] text-ink"
                },
                "text": "$t:community.login.title"
              },
              {
                "id": "login_lede",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mt-1 block text-[13px] leading-6 text-muted"
                },
                "text": "$t:community.login.lede"
              }
            ]
          },
          {
            "id": "login_form",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "pt-5"
            },
            "children": [
              {
                "id": "login_email_field",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mb-3"
                },
                "children": [
                  {
                    "id": "login_email_label",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                    },
                    "text": "$t:community.login.email_label"
                  },
                  {
                    "id": "login_email",
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "type": "email",
                      "name": "email",
                      "autoComplete": "username",
                      "placeholder": "$t:community.login.email_placeholder",
                      "aria-label": "$t:community.login.email_label",
                      "value": "{{_local.login_email ?? \"\"}}",
                      "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                    },
                    "actions": [
                      {
                        "type": "input",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "login_email": "{{$event.target.value}}",
                          "login_error": ""
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "login_password_field",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mb-3"
                },
                "children": [
                  {
                    "id": "login_password_label",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                    },
                    "text": "$t:community.login.password_label"
                  },
                  {
                    "id": "login_password",
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "type": "password",
                      "name": "password",
                      "autoComplete": "current-password",
                      "placeholder": "$t:community.login.password_placeholder",
                      "aria-label": "$t:community.login.password_label",
                      "value": "{{_local.login_password ?? \"\"}}",
                      "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                    },
                    "actions": [
                      {
                        "type": "input",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "login_password": "{{$event.target.value}}",
                          "login_error": ""
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "login_error",
                "type": "basic",
                "name": "Div",
                "props": {
                  "role": "alert",
                  "aria-live": "polite",
                  "className": "mt-2 rounded-ctl border border-danger-border bg-danger-wash px-3 py-2 text-[12px] text-danger"
                },
                "if": "{{_local.login_error}}",
                "text": "{{_local.login_error ?? \"\"}}"
              },
              {
                "id": "login_submit",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "mt-4 w-full cursor-pointer rounded-ctl bg-accent px-4 py-2.5 text-[14px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{_local.login_submitting === true}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "sequence",
                    "if": "{{_local.login_submitting !== true}}",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "login_submitting": true,
                          "login_error": ""
                        }
                      },
                      {
                        "handler": "login",
                        "target": "user",
                        "params": {
                          "body": {
                            "email": "{{_local.login_email ?? ''}}",
                            "password": "{{_local.login_password ?? ''}}"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "global",
                              "currentUser": "{{response.user}}"
                            }
                          },
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "login_submitting": false
                            }
                          },
                          {
                            "handler": "navigate",
                            "params": {
                              "path": "{{query.redirect ?? '/'}}"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "login_submitting": false,
                              "login_error": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "text": "$t:community.login.submit"
              },
              {
                "id": "login_forgot",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/forgot-password",
                  "className": "mt-3 block text-center text-[12px] text-muted hover:text-ink"
                },
                "text": "$t:community.login.forgot_password"
              },
              {
                "id": "login_to_register",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mt-4 text-center text-[13px] text-muted"
                },
                "children": [
                  {
                    "id": "login_to_register_text",
                    "type": "basic",
                    "name": "Span",
                    "text": "$t:community.login.no_account"
                  },
                  {
                    "id": "login_to_register_link",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/register",
                      "className": "ml-1 font-medium text-ink underline-offset-2 hover:underline"
                    },
                    "text": "$t:community.user.register"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
