{
  "version": "1.0.0",
  "layout_name": "reset-password",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.reset.page_title",
    "description": "$t:community.reset.page_description",
    "guest_only": true
  },
  "initLocal": {
    "reset_password": "",
    "reset_password_confirmation": "",
    "reset_submitting": false,
    "reset_error": ""
  },
  "slots": {
    "content": [
      {
        "id": "reset_root",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "mx-auto w-full max-w-[380px] overflow-hidden rounded-card border border-rule bg-paper-2 px-6 py-7"
        },
        "children": [
          {
            "id": "reset_title",
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "text-[22px] font-bold tracking-[-0.03em] text-ink"
            },
            "text": "$t:community.reset.title"
          },
          {
            "id": "reset_missing",
            "type": "basic",
            "name": "Div",
            "if": "{{!(query.token && query.email)}}",
            "props": {
              "className": "mt-5 text-[13px] text-muted"
            },
            "text": "$t:community.reset.invalid_link"
          },
          {
            "id": "reset_form",
            "type": "basic",
            "name": "Div",
            "if": "{{query.token && query.email}}",
            "props": {
              "className": "mt-5"
            },
            "children": [
              {
                "id": "reset_pw_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.new_password_label"
              },
              {
                "id": "reset_pw",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "password",
                  "name": "password",
                  "autoComplete": "new-password",
                  "aria-label": "$t:community.mypage.new_password_label",
                  "value": "{{_local.reset_password ?? \"\"}}",
                  "className": "mb-3 h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "reset_password": "{{$event.target.value}}",
                      "reset_error": ""
                    }
                  }
                ]
              },
              {
                "id": "reset_pw2_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.confirm_password_label"
              },
              {
                "id": "reset_pw2",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "password",
                  "name": "password_confirmation",
                  "autoComplete": "new-password",
                  "aria-label": "$t:community.mypage.confirm_password_label",
                  "value": "{{_local.reset_password_confirmation ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "reset_password_confirmation": "{{$event.target.value}}",
                      "reset_error": ""
                    }
                  }
                ]
              },
              {
                "id": "reset_error",
                "type": "basic",
                "name": "Div",
                "if": "{{_local.reset_error}}",
                "props": {
                  "role": "alert",
                  "aria-live": "polite",
                  "className": "mt-2 rounded-ctl border border-danger-border bg-danger-wash px-3 py-2 text-[12px] text-danger"
                },
                "text": "{{_local.reset_error ?? \"\"}}"
              },
              {
                "id": "reset_submit",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "mt-4 w-full cursor-pointer rounded-ctl bg-accent px-4 py-2.5 text-[14px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{_local.reset_submitting === true}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "sequence",
                    "if": "{{_local.reset_submitting !== true && (_local.reset_password ?? '') !== '' && _local.reset_password === _local.reset_password_confirmation}}",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "reset_submitting": true,
                          "reset_error": ""
                        }
                      },
                      {
                        "handler": "apiCall",
                        "target": "/api/auth/reset-password",
                        "params": {
                          "method": "POST",
                          "body": {
                            "token": "{{query.token ?? ''}}",
                            "email": "{{query.email ?? ''}}",
                            "password": "{{_local.reset_password ?? ''}}",
                            "password_confirmation": "{{_local.reset_password_confirmation ?? ''}}"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "reset_submitting": false
                            }
                          },
                          {
                            "handler": "navigate",
                            "params": {
                              "path": "/login"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "reset_submitting": false,
                              "reset_error": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "text": "$t:community.reset.submit"
              }
            ]
          },
          {
            "id": "reset_back",
            "type": "basic",
            "name": "A",
            "props": {
              "href": "/login",
              "className": "mt-4 block text-center text-[13px] text-muted hover:text-ink"
            },
            "text": "$t:community.forgot.back_to_login"
          }
        ]
      }
    ]
  }
}
