{
  "version": "1.0.0",
  "layout_name": "forgot-password",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.forgot.page_title",
    "description": "$t:community.forgot.page_description",
    "guest_only": true
  },
  "initLocal": {
    "forgot_email": "",
    "forgot_submitting": false,
    "forgot_error": "",
    "forgot_success": false
  },
  "slots": {
    "content": [
      {
        "id": "forgot_root",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "mx-auto w-full max-w-[380px] overflow-hidden rounded-card border border-rule bg-paper-2 px-6 py-7"
        },
        "children": [
          {
            "id": "forgot_title",
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "text-[22px] font-bold tracking-[-0.03em] text-ink"
            },
            "text": "$t:community.forgot.title"
          },
          {
            "id": "forgot_lede",
            "type": "basic",
            "name": "Span",
            "props": {
              "className": "mt-1 block text-[13px] leading-6 text-muted"
            },
            "text": "$t:community.forgot.lede"
          },
          {
            "id": "forgot_success",
            "type": "basic",
            "name": "Div",
            "if": "{{_local.forgot_success === true}}",
            "props": {
              "className": "mt-5 rounded-ctl border border-rule bg-paper px-3 py-3 text-[13px] text-ink"
            },
            "text": "$t:community.forgot.success"
          },
          {
            "id": "forgot_form",
            "type": "basic",
            "name": "Div",
            "if": "{{_local.forgot_success !== true}}",
            "props": {
              "className": "mt-5"
            },
            "children": [
              {
                "id": "forgot_email_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.login.email_label"
              },
              {
                "id": "forgot_email",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "email",
                  "name": "email",
                  "autoComplete": "username",
                  "placeholder": "$t:community.login.email_placeholder",
                  "aria-label": "$t:community.login.email_label",
                  "value": "{{_local.forgot_email ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "forgot_email": "{{$event.target.value}}",
                      "forgot_error": ""
                    }
                  }
                ]
              },
              {
                "id": "forgot_error",
                "type": "basic",
                "name": "Div",
                "if": "{{_local.forgot_error}}",
                "props": {
                  "role": "alert",
                  "aria-live": "polite",
                  "className": "mt-2 rounded-ctl border border-danger-border bg-danger-wash px-3 py-2 text-[12px] text-danger"
                },
                "text": "{{_local.forgot_error ?? \"\"}}"
              },
              {
                "id": "forgot_submit",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "mt-4 w-full cursor-pointer rounded-ctl bg-accent px-4 py-2.5 text-[14px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{_local.forgot_submitting === true}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "sequence",
                    "if": "{{_local.forgot_submitting !== true && (_local.forgot_email ?? '').trim() !== ''}}",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "forgot_submitting": true,
                          "forgot_error": ""
                        }
                      },
                      {
                        "handler": "apiCall",
                        "target": "/api/auth/forgot-password",
                        "params": {
                          "method": "POST",
                          "body": {
                            "email": "{{_local.forgot_email ?? ''}}"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "forgot_submitting": false,
                              "forgot_success": true
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "forgot_submitting": false,
                              "forgot_error": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "text": "$t:community.forgot.submit"
              }
            ]
          },
          {
            "id": "forgot_back",
            "type": "basic",
            "name": "A",
            "props": {
              "href": "/login",
              "className": "mt-4 block text-center text-[13px] text-muted hover:text-ink"
            },
            "text": "$t:community.forgot.back_to_login"
          }
        ]
      }
    ]
  }
}
