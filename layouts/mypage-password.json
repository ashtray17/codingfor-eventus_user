{
  "version": "1.0.0",
  "layout_name": "mypage-password",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.mypage.password_page_title",
    "description": "$t:community.mypage.page_description"
  },
  "initLocal": {
    "pw_current": "",
    "pw_new": "",
    "pw_confirm": "",
    "pw_submitting": false,
    "pw_error": ""
  },
  "slots": {
    "content": [
      {
        "id": "mypage_pw_root",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "mx-auto w-full max-w-[420px] overflow-hidden rounded-card border border-rule bg-paper-2 px-6 py-7"
        },
        "children": [
          {
            "id": "mypage_pw_title",
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "border-b border-rule pb-3 text-[22px] font-bold tracking-[-0.03em] text-ink"
            },
            "text": "$t:community.mypage.password_title"
          },
          {
            "id": "mypage_pw_current_field",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mt-5 mb-3"
            },
            "children": [
              {
                "id": "mypage_pw_current_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.current_password_label"
              },
              {
                "id": "mypage_pw_current",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "password",
                  "name": "current_password",
                  "autoComplete": "current-password",
                  "aria-label": "$t:community.mypage.current_password_label",
                  "value": "{{_local.pw_current ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "pw_current": "{{$event.target.value}}",
                      "pw_error": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "mypage_pw_new_field",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-3"
            },
            "children": [
              {
                "id": "mypage_pw_new_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.new_password_label"
              },
              {
                "id": "mypage_pw_new",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "password",
                  "name": "password",
                  "autoComplete": "new-password",
                  "aria-label": "$t:community.mypage.new_password_label",
                  "value": "{{_local.pw_new ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "pw_new": "{{$event.target.value}}",
                      "pw_error": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "mypage_pw_confirm_field",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-3"
            },
            "children": [
              {
                "id": "mypage_pw_confirm_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.confirm_password_label"
              },
              {
                "id": "mypage_pw_confirm",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "password",
                  "name": "password_confirmation",
                  "autoComplete": "new-password",
                  "aria-label": "$t:community.mypage.confirm_password_label",
                  "value": "{{_local.pw_confirm ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "pw_confirm": "{{$event.target.value}}",
                      "pw_error": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "mypage_pw_error",
            "type": "basic",
            "name": "Div",
            "if": "{{_local.pw_error}}",
            "props": {
              "role": "alert",
              "aria-live": "polite",
              "className": "mb-3 rounded-ctl border border-danger-border bg-danger-wash px-3 py-2 text-[12px] text-danger"
            },
            "text": "{{_local.pw_error ?? \"\"}}"
          },
          {
            "id": "mypage_pw_actions",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mt-4 flex justify-end gap-2"
            },
            "children": [
              {
                "id": "mypage_pw_cancel",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/mypage",
                  "className": "rounded-ctl border border-rule px-3.5 py-2 text-[13px] font-medium text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink"
                },
                "text": "$t:community.write.cancel"
              },
              {
                "id": "mypage_pw_submit",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "cursor-pointer rounded-ctl bg-accent px-4 py-2 text-[13px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{_local.pw_submitting === true}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "sequence",
                    "if": "{{_local.pw_submitting !== true && (_local.pw_current ?? '') !== '' && (_local.pw_new ?? '') !== '' && _local.pw_new === _local.pw_confirm}}",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "pw_submitting": true,
                          "pw_error": ""
                        }
                      },
                      {
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/me/password",
                        "params": {
                          "method": "PUT",
                          "body": {
                            "current_password": "{{_local.pw_current ?? ''}}",
                            "password": "{{_local.pw_new ?? ''}}",
                            "password_confirmation": "{{_local.pw_confirm ?? ''}}"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "pw_submitting": false,
                              "pw_current": "",
                              "pw_new": "",
                              "pw_confirm": ""
                            }
                          },
                          {
                            "handler": "navigate",
                            "params": {
                              "path": "/mypage"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "pw_submitting": false,
                              "pw_error": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "click",
                    "handler": "setState",
                    "if": "{{_local.pw_submitting !== true && _local.pw_new !== _local.pw_confirm}}",
                    "params": {
                      "target": "local",
                      "pw_error": "$t:community.register.error_password_mismatch"
                    }
                  }
                ],
                "text": "$t:community.mypage.save"
              }
            ]
          }
        ]
      }
    ]
  }
}
