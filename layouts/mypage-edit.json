{
  "version": "1.0.0",
  "layout_name": "mypage-edit",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.mypage.edit_page_title",
    "description": "$t:community.mypage.page_description"
  },
  "initLocal": {
    "edit_name": "",
    "edit_nickname": "",
    "edit_email": "",
    "edit_bio": "",
    "edit_submitting": false,
    "edit_error": ""
  },
  "data_sources": [
    {
      "id": "profile",
      "label_key": "$t:community.data_source.profile",
      "type": "api",
      "endpoint": "/api/me",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "required",
      "cache": false,
      "refetchOnMount": true,
      "loading_strategy": "blocking",
      "onSuccess": {
        "handler": "setState",
        "params": {
          "target": "local",
          "edit_name": "{{response.data.data.name ?? ''}}",
          "edit_nickname": "{{response.data.data.nickname ?? ''}}",
          "edit_email": "{{response.data.data.email ?? ''}}",
          "edit_bio": "{{response.data.data.bio ?? ''}}"
        }
      },
      "errorHandling": {
        "401": {
          "handler": "navigate",
          "params": {
            "path": "/login",
            "query": {
              "redirect": "/mypage/edit"
            }
          }
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "mypage_edit_root",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "mx-auto w-full max-w-[420px] overflow-hidden rounded-card border border-rule bg-paper-2 px-6 py-7"
        },
        "children": [
          {
            "id": "mypage_edit_title",
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "border-b border-rule pb-3 text-[22px] font-bold tracking-[-0.03em] text-ink"
            },
            "text": "$t:community.mypage.edit_title"
          },
          {
            "id": "mypage_edit_name_field",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mt-5 mb-3"
            },
            "children": [
              {
                "id": "mypage_edit_name_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.name_label"
              },
              {
                "id": "mypage_edit_name",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "text",
                  "name": "name",
                  "autoComplete": "name",
                  "aria-label": "$t:community.mypage.name_label",
                  "value": "{{_local.edit_name ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "edit_name": "{{$event.target.value}}",
                      "edit_error": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "mypage_edit_nick_field",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-3"
            },
            "children": [
              {
                "id": "mypage_edit_nick_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.nickname_label"
              },
              {
                "id": "mypage_edit_nick",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "text",
                  "name": "nickname",
                  "autoComplete": "nickname",
                  "aria-label": "$t:community.mypage.nickname_label",
                  "value": "{{_local.edit_nickname ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "edit_nickname": "{{$event.target.value}}",
                      "edit_error": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "mypage_edit_email_field",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-3"
            },
            "children": [
              {
                "id": "mypage_edit_email_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.email_label"
              },
              {
                "id": "mypage_edit_email",
                "type": "basic",
                "name": "Input",
                "props": {
                  "type": "email",
                  "name": "email",
                  "autoComplete": "email",
                  "aria-label": "$t:community.mypage.email_label",
                  "value": "{{_local.edit_email ?? \"\"}}",
                  "className": "h-11 w-full rounded-ctl border border-rule bg-paper-2 px-3 text-[14px] text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "edit_email": "{{$event.target.value}}",
                      "edit_error": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "mypage_edit_bio_field",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-3"
            },
            "children": [
              {
                "id": "mypage_edit_bio_label",
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "mb-1.5 block text-[10px] tracking-[0.1em] text-muted"
                },
                "text": "$t:community.mypage.bio_label"
              },
              {
                "id": "mypage_edit_bio",
                "type": "basic",
                "name": "Textarea",
                "props": {
                  "name": "bio",
                  "rows": 4,
                  "aria-label": "$t:community.mypage.bio_label",
                  "value": "{{_local.edit_bio ?? \"\"}}",
                  "className": "min-h-[96px] w-full resize-y rounded-ctl border border-rule bg-paper px-3 py-2.5 text-[14px] leading-6 text-ink transition-colors duration-150 placeholder:text-faint hover:border-rule-2 focus-visible:border-accent"
                },
                "actions": [
                  {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "edit_bio": "{{$event.target.value}}",
                      "edit_error": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "mypage_edit_error",
            "type": "basic",
            "name": "Div",
            "if": "{{_local.edit_error}}",
            "props": {
              "role": "alert",
              "aria-live": "polite",
              "className": "mb-3 rounded-ctl border border-danger-border bg-danger-wash px-3 py-2 text-[12px] text-danger"
            },
            "text": "{{_local.edit_error ?? \"\"}}"
          },
          {
            "id": "mypage_edit_actions",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mt-4 flex justify-end gap-2"
            },
            "children": [
              {
                "id": "mypage_edit_cancel",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/mypage",
                  "className": "rounded-ctl border border-rule px-3.5 py-2 text-[13px] font-medium text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink"
                },
                "text": "$t:community.write.cancel"
              },
              {
                "id": "mypage_edit_submit",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "cursor-pointer rounded-ctl bg-accent px-4 py-2 text-[13px] font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-40",
                  "disabled": "{{_local.edit_submitting === true}}"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "sequence",
                    "if": "{{_local.edit_submitting !== true && (_local.edit_name ?? '').trim() !== '' && (_local.edit_email ?? '').trim() !== ''}}",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "edit_submitting": true,
                          "edit_error": ""
                        }
                      },
                      {
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/me",
                        "params": {
                          "method": "PUT",
                          "body": {
                            "name": "{{_local.edit_name ?? ''}}",
                            "nickname": "{{_local.edit_nickname ?? ''}}",
                            "email": "{{_local.edit_email ?? ''}}",
                            "bio": "{{_local.edit_bio ?? ''}}"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "edit_submitting": false
                            }
                          },
                          {
                            "handler": "navigate",
                            "params": {
                              "path": "/mypage"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "edit_submitting": false,
                              "edit_error": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "text": "$t:community.mypage.save"
              }
            ]
          }
        ]
      }
    ]
  }
}
