{
  "version": "1.0.0",
  "layout_name": "home",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:community.home.page_title",
    "description": "$t:community.home.page_description",
    "seo": {
      "enabled": true,
      "data_sources": ["latest", "popular", "notice_photos", "baseball_photos"],
      "priority": 1.0,
      "changefreq": "daily",
      "og": {
        "type": "website"
      },
      "structured_data": {
        "@type": "WebSite",
        "name": "{{_global.site_name ?? ''}}"
      }
    }
  },
  "data_sources": [
    {
      "_comment": "전체 게시판 최근 게시글",
      "id": "latest",
      "label_key": "$t:community.data_source.latest",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/posts/recent",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "limit": 10
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "401": {
          "handler": "suppress"
        },
        "403": {
          "handler": "suppress"
        },
        "404": {
          "handler": "suppress"
        }
      }
    },
    {
      "_comment": "인기 글 (조회수 + 추천 점수 기준)",
      "id": "popular",
      "label_key": "$t:community.data_source.popular",
      "type": "api",
      "endpoint": "/api/modules/codingfor-recommend/boards/popular",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "limit": 10
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "401": {
          "handler": "suppress"
        },
        "403": {
          "handler": "suppress"
        },
        "404": {
          "handler": "suppress"
        }
      }
    },
    {
      "_comment": "공지사항 '사진' 말머리 최신 글 (썸네일 카드)",
      "id": "notice_photos",
      "label_key": "$t:community.data_source.notice_photos",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/notice/posts",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "category": "사진",
        "per_page": 10
      },
      "fallback": {
        "data": {
          "data": []
        }
      },
      "errorHandling": {
        "401": {
          "handler": "suppress"
        },
        "403": {
          "handler": "suppress"
        },
        "404": {
          "handler": "suppress"
        }
      }
    },
    {
      "_comment": "야구 '사진' 말머리 최신 글 (썸네일 카드)",
      "id": "baseball_photos",
      "label_key": "$t:community.data_source.baseball_photos",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/baseball/posts",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "category": "사진",
        "per_page": 10
      },
      "fallback": {
        "data": {
          "data": []
        }
      },
      "errorHandling": {
        "401": {
          "handler": "suppress"
        },
        "403": {
          "handler": "suppress"
        },
        "404": {
          "handler": "suppress"
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "home_root",
        "type": "basic",
        "name": "Div",
        "children": [
          {
            "id": "home_gallery",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-10 rounded-card border border-rule bg-paper-2"
            },
            "children": [
              {
                "id": "home_gallery_head",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex items-center justify-between gap-3 border-b border-rule px-4 pt-4 pb-3.5"
                },
                "children": [
                  {
                    "id": "home_gallery_head_left",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "min-w-0 flex-1"
                    },
                    "children": [
                      {
                        "id": "home_gallery_title_row",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "flex items-center gap-2"
                        },
                        "children": [
                          {
                            "id": "home_gallery_title",
                            "type": "basic",
                            "name": "H2",
                            "props": {
                              "className": "min-w-0 truncate text-[17px] font-bold tracking-[-0.02em] text-ink"
                            },
                            "text": "$t:community.home.gallery_title"
                          },
                          {
                            "id": "home_gallery_new_badge",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "shrink-0 rounded bg-danger-wash px-2 py-0.5 text-[11px] font-bold text-danger"
                            },
                            "text": "$t:community.home.gallery_badge"
                          }
                        ]
                      },
                      {
                        "id": "home_gallery_subtitle",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "mt-0.5 hidden truncate text-[12px] text-muted sm:block"
                        },
                        "text": "$t:community.home.gallery_subtitle"
                      }
                    ]
                  },
                  {
                    "id": "home_gallery_controls",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex shrink-0 items-center gap-1.5"
                    },
                    "children": [
                      {
                        "id": "home_gallery_prev",
                        "type": "basic",
                        "name": "Button",
                        "props": {
                          "type": "button",
                          "aria-label": "$t:community.home.gallery_prev",
                          "className": "flex h-11 w-9 cursor-pointer items-center justify-center rounded-ctl border border-rule text-[16px] leading-none text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink"
                        },
                        "text": "‹"
                      },
                      {
                        "id": "home_gallery_next",
                        "type": "basic",
                        "name": "Button",
                        "props": {
                          "type": "button",
                          "aria-label": "$t:community.home.gallery_next",
                          "className": "flex h-11 w-9 cursor-pointer items-center justify-center rounded-ctl border border-rule text-[16px] leading-none text-muted transition-colors duration-150 hover:border-rule-2 hover:text-ink"
                        },
                        "text": "›"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "home_gallery_empty",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "py-4 text-[13px] text-faint"
                },
                "if": "{{((notice_photos?.data?.data ?? []).concat(baseball_photos?.data?.data ?? [])).length === 0}}",
                "text": "$t:community.home.gallery_empty"
              },
              {
                "id": "home_gallery_track",
                "type": "basic",
                "name": "Div",
                "if": "{{((notice_photos?.data?.data ?? []).concat(baseball_photos?.data?.data ?? [])).length > 0}}",
                "props": {
                  "className": "scrollbar-hide flex cursor-grab gap-4 overflow-x-auto px-4 pt-4 pb-5 touch-pan-x"
                },
                "children": [
                  {
                    "id": "home_gallery_card_{{gallery_item.id}}",
                    "type": "basic",
                    "name": "A",
                    "iteration": {
                      "source": "{{(notice_photos?.data?.data ?? []).concat(baseball_photos?.data?.data ?? [])}}",
                      "item_var": "gallery_item"
                    },
                    "props": {
                      "href": "/board/{{gallery_item?.slug ?? \"baseball\"}}/{{gallery_item.id}}",
                      "className": "group w-[248px] shrink-0 sm:w-[272px]"
                    },
                    "children": [
                      {
                        "id": "home_gallery_thumb_{{gallery_item.id}}",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "aspect-[16/9] overflow-hidden rounded-ctl bg-paper-3"
                        },
                        "children": [
                          {
                            "id": "home_gallery_img_{{gallery_item.id}}",
                            "type": "basic",
                            "name": "Img",
                            "if": "{{gallery_item?.thumbnail}}",
                            "props": {
                              "src": "{{gallery_item?.thumbnail}}",
                              "alt": "{{gallery_item?.title ?? \"\"}}",
                              "className": "h-full w-full object-cover"
                            }
                          },
                          {
                            "id": "home_gallery_placeholder_{{gallery_item.id}}",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{!gallery_item?.thumbnail}}",
                            "props": {
                              "className": "flex h-full w-full items-center justify-center"
                            },
                            "children": [
                              {
                                "id": "home_gallery_placeholder_label_{{gallery_item.id}}",
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "text-[11px] text-faint"
                                },
                                "text": "$t:community.home.gallery_no_image"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "id": "home_gallery_card_badge_row_{{gallery_item.id}}",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "mt-2.5 flex items-center justify-between gap-2"
                        },
                        "children": [
                          {
                            "id": "home_gallery_card_cat_{{gallery_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "rounded bg-accent-wash px-2 py-0.5 text-[11px] font-semibold text-accent"
                            },
                            "text": "{{gallery_item?.category ?? \"사진\"}}"
                          },
                          {
                            "id": "home_gallery_card_date_{{gallery_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "tnum font-mono text-[11px] text-faint"
                            },
                            "text": "{{gallery_item?.created_at_formatted ?? \"\"}}"
                          }
                        ]
                      },
                      {
                        "id": "home_gallery_card_title_{{gallery_item.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "clamp-2 mt-1.5 block min-h-[2.5rem] text-[14px] font-semibold leading-5 text-ink transition-colors duration-150 group-hover:text-accent"
                        },
                        "text": "{{gallery_item?.title ?? \"\"}}"
                      },
                      {
                        "id": "home_gallery_card_meta_{{gallery_item.id}}",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "mt-2 flex items-center justify-between border-t border-rule pt-2"
                        },
                        "children": [
                          {
                            "id": "home_gallery_card_author_{{gallery_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "max-w-[130px] truncate text-[11px] text-muted"
                            },
                            "text": "{{gallery_item?.author?.name ?? gallery_item?.writer ?? \"\"}}"
                          },
                          {
                            "id": "home_gallery_card_stats_{{gallery_item.id}}",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "flex items-center gap-1.5"
                            },
                            "children": [
                              {
                                "id": "home_gallery_card_views_{{gallery_item.id}}",
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "tnum font-mono text-[11px] text-faint"
                                },
                                "text": "{{gallery_item?.view_count ?? 0}}"
                              },
                              {
                                "id": "home_gallery_card_dot_{{gallery_item.id}}",
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "text-[11px] text-faint"
                                },
                                "text": "·"
                              },
                              {
                                "id": "home_gallery_card_cc_{{gallery_item.id}}",
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "tnum font-mono text-[11px] font-semibold text-accent"
                                },
                                "text": "{{gallery_item?.comment_count ?? 0}}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "home_feed",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-10 overflow-hidden rounded-card border border-rule bg-paper-2"
            },
            "children": [
              {
                "comment": "zod.kr-style tab header: latest | popular",
                "id": "home_feed_tabs",
                "type": "basic",
                "name": "Div",
                "props": {
                  "role": "tablist",
                  "className": "flex items-end gap-1 border-b border-rule px-4 pt-3"
                },
                "children": [
                  {
                    "id": "home_tab_latest_on",
                    "type": "basic",
                    "name": "Button",
                    "if": "{{_global.homeTab !== 'popular'}}",
                    "props": {
                      "type": "button",
                      "role": "tab",
                      "aria-selected": "true",
                      "className": "cursor-pointer border-b-2 border-accent px-3 pb-2 text-[14px] font-bold tracking-[-0.02em] text-ink"
                    },
                    "text": "$t:community.home.tab_latest"
                  },
                  {
                    "id": "home_tab_latest_off",
                    "type": "basic",
                    "name": "Button",
                    "if": "{{_global.homeTab === 'popular'}}",
                    "props": {
                      "type": "button",
                      "role": "tab",
                      "aria-selected": "false",
                      "className": "cursor-pointer border-b-2 border-transparent px-3 pb-2 text-[14px] font-medium text-muted transition-colors duration-150 hover:text-ink"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "setState",
                        "params": {
                          "target": "global",
                          "homeTab": "latest"
                        }
                      }
                    ],
                    "text": "$t:community.home.tab_latest"
                  },
                  {
                    "id": "home_tab_popular_on",
                    "type": "basic",
                    "name": "Button",
                    "if": "{{_global.homeTab === 'popular'}}",
                    "props": {
                      "type": "button",
                      "role": "tab",
                      "aria-selected": "true",
                      "className": "cursor-pointer border-b-2 border-accent px-3 pb-2 text-[14px] font-bold tracking-[-0.02em] text-ink"
                    },
                    "text": "$t:community.home.tab_popular"
                  },
                  {
                    "id": "home_tab_popular_off",
                    "type": "basic",
                    "name": "Button",
                    "if": "{{_global.homeTab !== 'popular'}}",
                    "props": {
                      "type": "button",
                      "role": "tab",
                      "aria-selected": "false",
                      "className": "cursor-pointer border-b-2 border-transparent px-3 pb-2 text-[14px] font-medium text-muted transition-colors duration-150 hover:text-ink"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "setState",
                        "params": {
                          "target": "global",
                          "homeTab": "popular"
                        }
                      }
                    ],
                    "text": "$t:community.home.tab_popular"
                  },
                  {
                    "id": "home_feed_subtitle",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "ml-auto hidden pb-2.5 text-[12px] text-muted sm:inline"
                    },
                    "text": "$t:community.home.feed_subtitle"
                  }
                ]
              },
              {
                "id": "home_latest_empty",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "px-4 py-4 text-[13px] text-faint"
                },
                "if": "{{_global.homeTab !== 'popular' && (latest?.data ?? []).length === 0}}",
                "text": "$t:community.sidebar.empty"
              },
              {
                "id": "home_latest_list",
                "type": "basic",
                "name": "Div",
                "if": "{{_global.homeTab !== 'popular' && (latest?.data ?? []).length > 0}}",
                "props": {
                  "className": "px-2 pb-1"
                },
                "children": [
                  {
                    "id": "home_latest_ruler",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "hidden"
                    },
                    "children": [
                      {
                        "id": "home_latest_ruler_c1",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "hidden w-16 shrink-0 text-[10px] tracking-[0.1em] text-faint sm:block"
                        },
                        "text": "$t:community.board.col_board"
                      },
                      {
                        "id": "home_latest_ruler_c2",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "min-w-0 flex-1 text-[10px] tracking-[0.1em] text-faint"
                        },
                        "text": "$t:community.board.col_title"
                      },
                      {
                        "id": "home_latest_ruler_c3",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "hidden w-24 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint md:block"
                        },
                        "text": "$t:community.board.col_author"
                      },
                      {
                        "id": "home_latest_ruler_c4",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "hidden w-20 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint sm:block"
                        },
                        "text": "$t:community.board.col_date"
                      },
                      {
                        "id": "home_latest_ruler_c5",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "hidden w-12 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint lg:block"
                        },
                        "text": "$t:community.board.col_views"
                      }
                    ]
                  },
                  {
                    "id": "home_post_{{post_item.id}}",
                    "type": "basic",
                    "name": "A",
                    "iteration": {
                      "source": "{{latest?.data ?? []}}",
                      "item_var": "post_item"
                    },
                    "props": {
                      "href": "/board/{{post_item.board_slug}}/{{post_item.id}}",
                      "className": "group flex flex-wrap items-center gap-x-3 gap-y-1.5 border-b border-rule px-2 py-3 last:border-0 transition-colors duration-150 hover:bg-paper-3 sm:flex-nowrap sm:gap-3 sm:px-4 sm:py-3"
                    },
                    "children": [
                      {
                        "id": "home_post_cat_{{post_item.id}}",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "hidden shrink-0 rounded bg-accent-wash px-2 py-0.5 text-[11px] font-semibold text-accent sm:block"
                        },
                        "text": "{{post_item?.board_name ?? \"\"}}"
                      },
                      {
                        "id": "home_post_main_{{post_item.id}}",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "flex min-w-0 flex-1 items-baseline gap-1.5"
                        },
                        "children": [
                          {
                            "id": "home_post_notice_{{post_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "shrink-0 rounded bg-accent-wash px-1.5 py-0.5 text-[10px] font-semibold text-accent"
                            },
                            "if": "{{post_item?.is_notice}}",
                            "text": "$t:community.board.notice"
                          },
                          {
                            "id": "home_post_title_{{post_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "min-w-0 truncate text-[14px] font-medium text-ink-2 group-hover:text-accent"
                            },
                            "text": "{{post_item?.title ?? \"\"}}"
                          },
                          {
                            "id": "home_post_cc_{{post_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "tnum shrink-0 rounded bg-paper-3 px-1.5 py-0.5 font-mono text-[11px] font-semibold text-accent"
                            },
                            "if": "{{(post_item?.comment_count ?? 0) > 0}}",
                            "text": "{{post_item?.comment_count ?? 0}}"
                          },
                          {
                            "id": "home_post_new_{{post_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "shrink-0 rounded bg-danger-wash px-1.5 py-0.5 font-mono text-[10px] font-bold text-danger"
                            },
                            "if": "{{post_item?.is_new}}",
                            "text": "NEW"
                          }
                        ]
                      },
                      {
                        "id": "home_post_desktop_meta_{{post_item.id}}",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "hidden shrink-0 items-center gap-2 text-[11px] text-faint sm:flex"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "tnum shrink-0"
                            },
                            "text": "{{post_item?.created_at_formatted ?? \"\"}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "·"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:community.board.col_views"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "tnum font-mono"
                            },
                            "text": "{{post_item?.view_count ?? 0}}"
                          }
                        ]
                      },
                      {
                        "id": "home_post_mobile_meta_{{post_item.id}}",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "flex basis-full min-w-0 items-center gap-1.5 text-[11px] text-faint sm:hidden"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "min-w-0 truncate"
                            },
                            "text": "{{post_item?.board_name ?? \"\"}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "·"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "tnum shrink-0"
                            },
                            "text": "{{post_item?.created_at_formatted ?? \"\"}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "·"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "shrink-0"
                            },
                            "text": "$t:community.board.col_views"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "tnum shrink-0 font-mono"
                            },
                            "text": "{{post_item?.view_count ?? 0}}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "comment": "popular tab content — visible when _global.homeTab === 'popular'",
                "id": "home_popular",
                "type": "basic",
                "name": "Div",
                "if": "{{_global.homeTab === 'popular'}}",
                "children": [
                  {
                    "id": "home_popular_empty",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                  "className": "px-4 py-4 text-[13px] text-faint"
                    },
                    "if": "{{(popular?.data ?? []).length === 0}}",
                    "text": "$t:community.sidebar.empty"
                  },
                  {
                    "id": "home_popular_list",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(popular?.data ?? []).length > 0}}",
                    "props": {
                      "className": "px-1.5 pb-1 sm:px-1"
                    },
                    "children": [
                      {
                        "id": "home_popular_ruler",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "hidden"
                        },
                        "children": [
                          {
                            "id": "home_popular_ruler_rank",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "w-7 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint"
                            },
                            "text": "$t:community.home.popular_rank"
                          },
                          {
                            "id": "home_popular_ruler_title",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "min-w-0 flex-1 text-[10px] tracking-[0.1em] text-faint"
                            },
                            "text": "$t:community.board.col_title"
                          },
                          {
                            "id": "home_popular_ruler_board",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "hidden w-20 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint sm:block"
                            },
                            "text": "$t:community.board.col_board"
                          },
                          {
                            "id": "home_popular_ruler_views",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "hidden w-12 shrink-0 text-right text-[10px] tracking-[0.1em] text-faint sm:block"
                            },
                            "text": "$t:community.board.col_views"
                          }
                        ]
                      },
                      {
                        "id": "home_popular_row_{{pop_item.id}}",
                        "type": "basic",
                        "name": "A",
                        "iteration": {
                          "source": "{{popular?.data ?? []}}",
                          "item_var": "pop_item",
                          "index_var": "pop_idx"
                        },
                        "props": {
                          "href": "/board/{{pop_item.board_slug}}/{{pop_item.id}}",
                          "className": "group flex flex-wrap items-center gap-x-1.5 gap-y-1.5 border-b border-rule px-1.5 py-3 last:border-0 transition-colors duration-150 hover:bg-paper-3 sm:flex-nowrap sm:gap-2 sm:px-2 sm:py-3"
                        },
                        "children": [
                          {
                            "id": "home_popular_cluster_{{pop_item.id}}",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "flex min-w-0 flex-1 items-start gap-1.5 sm:items-center sm:gap-1"
                            },
                            "children": [
                              {
                                "id": "home_popular_rank_top_{{pop_item.id}}",
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "tnum w-auto shrink-0 text-left font-mono text-[12px] font-bold text-accent"
                                },
                                "if": "{{(pop_idx + 1) <= 3}}",
                                "text": "{{pop_idx + 1}}"
                              },
                              {
                                "id": "home_popular_rank_rest_{{pop_item.id}}",
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "tnum w-auto shrink-0 text-left font-mono text-[12px] text-faint"
                                },
                                "if": "{{(pop_idx + 1) > 3}}",
                                "text": "{{pop_idx + 1}}"
                              },
                              {
                                "id": "home_popular_stack_{{pop_item.id}}",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                  "className": "flex min-w-0 flex-1 flex-col gap-0.5"
                                },
                                "children": [
                                  {
                                    "id": "home_popular_main_{{pop_item.id}}",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                      "className": "flex min-w-0 items-baseline gap-1.5"
                                    },
                                    "children": [
                                      {
                                        "id": "home_popular_title_text_{{pop_item.id}}",
                                        "type": "basic",
                                        "name": "Span",
                                        "props": {
                                          "className": "min-w-0 truncate text-[14px] text-ink-2 group-hover:text-accent"
                                        },
                                        "text": "{{pop_item?.title ?? \"\"}}"
                                      },
                                      {
                                        "id": "home_popular_cc_{{pop_item.id}}",
                                        "type": "basic",
                                        "name": "Span",
                                        "props": {
                                          "className": "tnum shrink-0 font-mono text-[11px] font-semibold text-accent"
                                        },
                                        "if": "{{(pop_item?.comment_count ?? 0) > 0}}",
                                        "text": "{{pop_item?.comment_count ?? 0}}"
                                      }
                                    ]
                                  },
                                  {
                                    "id": "home_popular_mobile_meta_{{pop_item.id}}",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                      "className": "flex min-w-0 items-center gap-1.5 text-[11px] text-faint sm:hidden"
                                    },
                                    "children": [
                                      {
                                        "type": "basic",
                                        "name": "Span",
                                        "props": {
                                          "className": "min-w-0 truncate"
                                        },
                                        "text": "{{pop_item?.board_name ?? \"\"}}"
                                      },
                                      {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "·"
                                      },
                                      {
                                        "type": "basic",
                                        "name": "Span",
                                        "props": {
                                          "className": "shrink-0"
                                        },
                                        "text": "$t:community.board.col_views"
                                      },
                                      {
                                        "type": "basic",
                                        "name": "Span",
                                        "props": {
                                          "className": "tnum shrink-0 font-mono"
                                        },
                                        "text": "{{pop_item?.view_count ?? 0}}"
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "id": "home_popular_desktop_meta_{{pop_item.id}}",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "hidden shrink-0 items-center gap-2 text-[11px] text-faint sm:flex"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "max-w-24 truncate text-muted"
                                },
                                "text": "{{pop_item?.board_name ?? \"\"}}"
                              },
                              {
                                "type": "basic",
                                "name": "Span",
                                "text": "·"
                              },
                              {
                                "type": "basic",
                                "name": "Span",
                                "text": "$t:community.board.col_views"
                              },
                              {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "tnum font-mono"
                                },
                                "text": "{{pop_item?.view_count ?? 0}}"
                              }
                            ]
                          },
                          {
                            "id": "home_popular_board_{{pop_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "hidden"
                            },
                            "text": "{{pop_item?.board_name ?? \"\"}}"
                          },
                          {
                            "id": "home_popular_views_{{pop_item.id}}",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "hidden"
                            },
                            "text": "{{pop_item?.view_count ?? 0}}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
